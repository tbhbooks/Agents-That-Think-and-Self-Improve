# tbh-code .env template
# Uncomment ONE preset below and fill values.

# -------------------------------------------------------------------
# Preset A: API backend (required baseline for this book)
# -------------------------------------------------------------------
# TBH_LLM_BACKEND=api
# TBH_MODEL=anthropic:claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# -------------------------------------------------------------------
# Preset B: CLI backend - Claude
# -------------------------------------------------------------------
# TBH_LLM_BACKEND=cli
# TBH_CLI_BACKEND=claude
# TBH_ADAPTERS_PATH=tbh-agent-adapters/python

# -------------------------------------------------------------------
# Preset C: CLI backend - Cursor
# -------------------------------------------------------------------
# TBH_LLM_BACKEND=cli
# TBH_CLI_BACKEND=cursor
# TBH_ADAPTERS_PATH=tbh-agent-adapters/python

# -------------------------------------------------------------------
