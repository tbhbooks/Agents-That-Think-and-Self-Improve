# tbh-code .env template
# Uncomment ONE preset below and fill values.

# -------------------------------------------------------------------
# Preset A: API backend (required baseline for this book)
# -------------------------------------------------------------------
# TBH_LLM_BACKEND=api
# TBH_MODEL=anthropic:claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# -------------------------------------------------------------------
# Preset B: CLI backend - Claude
# -------------------------------------------------------------------
# Note: this does not work from inside an active Claude Code session.
# In that case use Preset C/D, or switch back to Preset A.
# TBH_LLM_BACKEND=cli
# TBH_CLI_BACKEND=claude
# TBH_ADAPTERS_PATH=tbh-agent-adapters/python

# -------------------------------------------------------------------
# Preset C: CLI backend - Cursor
# -------------------------------------------------------------------
# TBH_LLM_BACKEND=cli
# TBH_CLI_BACKEND=agent
# TBH_ADAPTERS_PATH=tbh-agent-adapters/python

# -------------------------------------------------------------------
# Preset D: CLI backend - Codex
# -------------------------------------------------------------------
# TBH_LLM_BACKEND=cli
# TBH_CLI_BACKEND=codex
# TBH_ADAPTERS_PATH=tbh-agent-adapters/python
# -------------------------------------------------------------------
# Validation mode
# -------------------------------------------------------------------
# Default: external — smoke tests (live LLM calls) are skipped when the
# agent runs pytest, preventing timeouts inside Cursor / Claude Code.
# The agent will print the exact command; run it in a separate terminal
# and paste the result back.
#
# To run smoke tests directly inside the agent terminal, change to: inline
TBH_VALIDATION_MODE=external
TBH_PROJECT_ROOT=./tbh-code
